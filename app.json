{
  "expo": {
    "name": "Hisab",
    "slug": "hisab",
    "scheme": "hisab",
    "version": "1.4.4",
    "orientation": "portrait",
    "icon": "./assets/icon/totals_icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.hisab.budget",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/totals_icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hisab to unlock with biometrics."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hisab to scan account QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
